{
  "name": "dsh-qqbot-q-mobile",
  "version": "0.1.1",
  "description": "Unofficial Android DSH wrapper delegating official Tencent QQ Bot 0.5.5, including its QR binding and settings UI.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "bin": {
    "q-mobile-doctor": "./bin/q-mobile-doctor.mjs"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "bin/q-mobile-doctor.mjs",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_LICENSE_TENCENT.txt",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "doctor": "node bin/q-mobile-doctor.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "android",
    "qqbot",
    "tencent-connect",
    "official-sdk-wrapper",
    "non-official"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      },
      "note": "Includes adapted official 0.5.5 client UI; only loader id, details subject match, and optional desktop-only sidebar injection adapted for Android. Android UI real-device E2E pending."
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@tencent-connect/dsh-qqbot": "0.5.5"
  }
}
