{
  "name": "dsh-qqbot-q-mobile",
  "version": "0.1.0",
  "description": "Unofficial Android DSH installation wrapper around Tencent Connect's official QQ Bot plugin 0.5.5; official transport and auth untouched.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "q-mobile-doctor": "./bin/q-mobile-doctor.mjs"
  },
  "files": [
    "lib/index.js",
    "bin/q-mobile-doctor.mjs",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "doctor": "node bin/q-mobile-doctor.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "android",
    "qqbot",
    "tencent-connect",
    "official-sdk-wrapper",
    "non-official"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      },
      "note": "Wrapper based on official 0.5.5 API; static tests only. Android DSH end-to-end binding has not been verified."
    }
  },
  "dependencies": {
    "@tencent-connect/dsh-qqbot": "0.5.5"
  }
}
